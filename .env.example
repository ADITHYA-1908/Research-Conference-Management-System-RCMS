# ==============================================================================
# Research Conference Management System (RCMS) - Environment Variables
# Copy this file to .env before starting the application or running Docker Compose.
# ==============================================================================

# Application Port
SERVER_PORT=8080

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Docker Compose & Production)
MYSQL_DATABASE=rcms_db
MYSQL_USER=rcms_user
MYSQL_PASSWORD=rcms_password_2026
MYSQL_ROOT_PASSWORD=rcms_root_password_2026

# Application Database Connection Settings
# For Docker Compose: DB_HOST should be set to 'db'
# For Local Host Execution: DB_HOST should be 'localhost'
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rcms_db
DB_USERNAME=rcms_user
DB_PASSWORD=rcms_password_2026
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Fallback Database URL (Explicit override if DB_HOST/DB_NAME is not used)
# DATABASE_URL=jdbc:mysql://localhost:3306/rcms_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# File Upload Storage Directory
UPLOAD_DIR=uploads/papers
